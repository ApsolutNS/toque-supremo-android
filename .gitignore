# --- Compilaciones y exportaciones ---
*.apk
*.aab
*.idsig
build/
builds/
export/
exports/
android/build/

# --- Archivos temporales y de respaldo ---
*.tmp
*.temp
*.bak
*.swp
*~
*.log

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Configuración personal de editores ---
.idea/
*.code-workspace

